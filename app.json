{
  "expo": {
    "name": "edai",
    "slug": "edai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/default.png",
    "scheme": "edai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon/Assets/profile.png",
      "bundleIdentifier": "com.fvrvz.edai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/expo.icon/Assets/default.png",
        "backgroundImage": "./assets/expo.icon/Assets/default.png",
        "monochromeImage": "./assets/expo.icon/Assets/default.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fvrvz.edai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/expo.icon/Assets/vector/default.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/expo.icon/Assets/profile.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "react-native-enriched-markdown"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b749bdd7-c1c9-4e39-b76f-1b6bdd036444"
      }
    },
    "owner": "fayso-labs"
  }
}
